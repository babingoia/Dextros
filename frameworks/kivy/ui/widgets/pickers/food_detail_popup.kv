#:import app_theme frameworks.kivy.ui.app_theme

<FoodDetailContent>:
    orientation: "vertical"
    spacing: app_theme.space("md")
    size_hint_y: None
    height: self.minimum_height

    # Nome do alimento — quebra em várias linhas quando a descrição da TACO é longa
    Label:
        text: root.food.description if root.food else ""
        bold: True
        font_size: app_theme.font("title")
        color: app_theme.color("text_primary")
        size_hint_y: None
        height: self.texture_size[1]
        text_size: self.width, None
        halign: "left"
        valign: "middle"

    Label:
        id: category_label
        text: root.food.category if root.food else ""
        font_size: app_theme.font("field")
        color: app_theme.color("text_hint")
        size_hint_y: None
        height: app_theme.widget("field_label_height")
        text_size: self.size
        halign: "left"
        valign: "middle"
        shorten: True

    # Tabela de detalhes por 100g — rótulo à esquerda, valor numérico alinhado à direita.
    # Altura explícita em cada célula: sem row_force_default, a linha cresce para o
    # maior filho e FieldLabel (22dp) e ReadOnlyField (48dp por default) ficam alinhados.
    GridLayout:
        cols: 2
        size_hint_y: None
        height: self.minimum_height
        spacing: [0, app_theme.space("xs")]

        FieldLabel:
            text: "Energia (kcal)"
            height: app_theme.widget("row_height")
        ReadOnlyField:
            text: root.energy_text
            height: app_theme.widget("row_height")
            padding_x: 0
            halign: "right"

        FieldLabel:
            text: "Proteína (g)"
            height: app_theme.widget("row_height")
        ReadOnlyField:
            text: root.protein_text
            height: app_theme.widget("row_height")
            padding_x: 0
            halign: "right"

        FieldLabel:
            text: "Carboidrato (g)"
            height: app_theme.widget("row_height")
        ReadOnlyField:
            text: root.carb_text
            height: app_theme.widget("row_height")
            padding_x: 0
            halign: "right"

        FieldLabel:
            text: "Gordura (g)"
            height: app_theme.widget("row_height")
        ReadOnlyField:
            text: root.fat_text
            height: app_theme.widget("row_height")
            padding_x: 0
            halign: "right"

        FieldLabel:
            text: "Fibra (g)"
            height: app_theme.widget("row_height")
        ReadOnlyField:
            text: root.fiber_text
            height: app_theme.widget("row_height")
            padding_x: 0
            halign: "right"

        FieldLabel:
            text: "Sódio (mg)"
            height: app_theme.widget("row_height")
        ReadOnlyField:
            text: root.sodium_text
            height: app_theme.widget("row_height")
            padding_x: 0
            halign: "right"

    # Preview ao vivo da porção digitada — vazio enquanto não há quantidade válida
    ReadOnlyField:
        text: root.portion_summary
        color: app_theme.color("text_secondary")
        bold: True
        height: app_theme.widget("input_height") if root.portion_summary else 0
        opacity: 1 if root.portion_summary else 0

    AppTextInput:
        id: grams_input
        input_type: "number"
        hint_text: "Quantidade em gramas (ex.: 150)"
        on_text: root._update_portion()

    Label:
        text: root.message
        font_size: app_theme.font("caption")
        color: app_theme.color("danger")
        size_hint_y: None
        height: app_theme.widget("field_label_height") if root.message else 0
        opacity: 1 if root.message else 0
        text_size: self.size
        halign: "left"
        valign: "middle"

    PrimaryButton:
        text: "Adicionar"
        size_hint_y: None
        height: app_theme.widget("button_height")
        on_release: root.confirm()
