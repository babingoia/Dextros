#:import app_theme frameworks.kivy.ui.app_theme

<FoodDetailContent>:
    orientation: "vertical"
    spacing: app_theme.space("md")
    # Gutter à direita: a barra de rolagem do dialog é desenhada SOBRE o
    # conteúdo na borda — sem este respiro, a scrollbar cobre o texto dos
    # valores (reportado em uso real).
    padding: [0, 0, app_theme.space("lg"), 0]
    size_hint_y: None
    height: self.minimum_height

    # Nome do alimento — quebra em várias linhas quando a descrição da TACO é longa
    Label:
        text: root.food.description if root.food else ""
        bold: True
        font_size: app_theme.font("title")
        color: app_theme.color("text_primary")
        size_hint_y: None
        height: self.texture_size[1]
        text_size: self.width, None
        halign: "left"
        valign: "middle"

    Label:
        id: category_label
        text: root.food.category if root.food else ""
        font_size: app_theme.font("field")
        color: app_theme.color("text_hint")
        size_hint_y: None
        height: app_theme.widget("field_label_height")
        text_size: self.size
        halign: "left"
        valign: "middle"
        shorten: True

    # Tabela de detalhes por 100g — rótulo à esquerda, número CENTRALIZADO na
    # coluna dele. Valores são Labels puras (sem caixa de campo): caixa com
    # borda parece campo editável e convida o usuário a digitar onde não dá
    # (reportado em uso real). Altura explícita em cada célula: sem
    # row_force_default, a linha cresce para o maior filho e FieldLabel (22dp)
    # e o valor ficam alinhados.
    GridLayout:
        cols: 2
        size_hint_y: None
        height: self.minimum_height
        spacing: [0, app_theme.space("xs")]

        FieldLabel:
            text: "Energia (kcal)"
            height: app_theme.widget("row_height")
        Label:
            text: root.energy_text
            bold: True
            font_size: app_theme.font("field")
            color: app_theme.color("text_primary")
            height: app_theme.widget("row_height")
            text_size: self.size
            halign: "center"
            valign: "middle"

        FieldLabel:
            text: "Proteína (g)"
            height: app_theme.widget("row_height")
        Label:
            text: root.protein_text
            bold: True
            font_size: app_theme.font("field")
            color: app_theme.color("text_primary")
            height: app_theme.widget("row_height")
            text_size: self.size
            halign: "center"
            valign: "middle"

        FieldLabel:
            text: "Carboidrato (g)"
            height: app_theme.widget("row_height")
        Label:
            text: root.carb_text
            bold: True
            font_size: app_theme.font("field")
            color: app_theme.color("text_primary")
            height: app_theme.widget("row_height")
            text_size: self.size
            halign: "center"
            valign: "middle"

        FieldLabel:
            text: "Gordura (g)"
            height: app_theme.widget("row_height")
        Label:
            text: root.fat_text
            bold: True
            font_size: app_theme.font("field")
            color: app_theme.color("text_primary")
            height: app_theme.widget("row_height")
            text_size: self.size
            halign: "center"
            valign: "middle"

        FieldLabel:
            text: "Fibra (g)"
            height: app_theme.widget("row_height")
        Label:
            text: root.fiber_text
            bold: True
            font_size: app_theme.font("field")
            color: app_theme.color("text_primary")
            height: app_theme.widget("row_height")
            text_size: self.size
            halign: "center"
            valign: "middle"

        FieldLabel:
            text: "Sódio (mg)"
            height: app_theme.widget("row_height")
        Label:
            text: root.sodium_text
            bold: True
            font_size: app_theme.font("field")
            color: app_theme.color("text_primary")
            height: app_theme.widget("row_height")
            text_size: self.size
            halign: "center"
            valign: "middle"

    # Preview ao vivo da porção digitada — texto corrido, não campo: sem caixa,
    # com quebra de linha quando a frase não cabe. Vazio enquanto não há
    # quantidade válida.
    Label:
        text: root.portion_summary
        font_size: app_theme.font("field")
        bold: True
        color: app_theme.color("text_secondary")
        size_hint_y: None
        text_size: self.width, None
        height: max(app_theme.widget("field_label_height"), self.texture_size[1]) if root.portion_summary else 0
        opacity: 1 if root.portion_summary else 0
        halign: "left"
        valign: "middle"

    AppTextInput:
        id: grams_input
        input_type: "number"
        hint_text: "Quantidade em gramas (ex.: 150)"
        on_text: root._update_portion()

    Label:
        text: root.message
        font_size: app_theme.font("caption")
        color: app_theme.color("danger")
        size_hint_y: None
        height: app_theme.widget("field_label_height") if root.message else 0
        opacity: 1 if root.message else 0
        text_size: self.size
        halign: "left"
        valign: "middle"

    PrimaryButton:
        text: "Adicionar"
        size_hint_y: None
        height: app_theme.widget("button_height")
        on_release: root.confirm()
