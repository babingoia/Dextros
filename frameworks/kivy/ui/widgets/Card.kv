<CardWidget>:
    orientation: "vertical"
    size_hint_y: None
    height: self.minimum_height
    spacing: app_theme.space("row")

    GridLayout:
        cols: 2
        size_hint_y: None
        height: self.minimum_height
        row_default_height: app_theme.widget("row_height")
        row_force_default: True
        spacing: [app_theme.space("xl"), app_theme.space("row")]

        BoxLayout:
            spacing: app_theme.space("sm")
            Label:
                text: "Data:"
                bold: True
                color: app_theme.color("text_secondary")
                size_hint_x: None
                width: app_theme.widget("field_label_width")
                halign: "right"
                text_size: self.size
                valign: "middle"
            Label:
                id: data_value
                text: ""
                color: app_theme.color("text_primary")
                halign: "left"
                text_size: self.size
                valign: "middle"

        BoxLayout:
            spacing: app_theme.space("sm")
            Label:
                text: "Horário:"
                bold: True
                color: app_theme.color("text_secondary")
                size_hint_x: None
                width: app_theme.widget("field_label_width")
                halign: "right"
                text_size: self.size
                valign: "middle"
            Label:
                id: horario_value
                text: ""
                color: app_theme.color("text_primary")
                halign: "left"
                text_size: self.size
                valign: "middle"

        BoxLayout:
            spacing: app_theme.space("sm")
            Label:
                text: "Lenta:"
                bold: True
                color: app_theme.color("text_secondary")
                size_hint_x: None
                width: app_theme.widget("field_label_width")
                halign: "right"
                text_size: self.size
                valign: "middle"
            Label:
                id: lenta_value
                text: ""
                color: app_theme.color("text_primary")
                halign: "left"
                text_size: self.size
                valign: "middle"

        BoxLayout:
            spacing: app_theme.space("sm")
            Label:
                text: "Rápida:"
                bold: True
                color: app_theme.color("text_secondary")
                size_hint_x: None
                width: app_theme.widget("field_label_width")
                halign: "right"
                text_size: self.size
                valign: "middle"
            Label:
                id: rapida_value
                text: ""
                color: app_theme.color("text_primary")
                halign: "left"
                text_size: self.size
                valign: "middle"

        BoxLayout:
            spacing: app_theme.space("sm")
            Label:
                text: "Exercício:"
                bold: True
                color: app_theme.color("text_secondary")
                size_hint_x: None
                width: app_theme.widget("field_label_width")
                halign: "right"
                text_size: self.size
                valign: "middle"
            Label:
                id: exercicio_value
                text: ""
                color: app_theme.color("text_primary")
                halign: "left"
                text_size: self.size
                valign: "middle"

        BoxLayout:
            spacing: app_theme.space("sm")
            Label:
                text: "Refeição:"
                bold: True
                color: app_theme.color("text_secondary")
                size_hint_x: None
                width: app_theme.widget("field_label_width")
                halign: "right"
                text_size: self.size
                valign: "middle"
            Label:
                id: refeicao_value
                text: ""
                color: app_theme.color("text_primary")
                halign: "left"
                text_size: self.size
                valign: "middle"

    # Dextro em destaque, mas alinhado como os demais campos
    BoxLayout:
        size_hint_y: None
        height: app_theme.widget("row_height")
        spacing: app_theme.space("sm")

        Label:
            text: "Dextro:"
            bold: True
            color: app_theme.color("text_secondary")
            size_hint_x: None
            width: app_theme.widget("field_label_width")
            halign: "right"
            text_size: self.size
            valign: "middle"

        Label:
            id: dextro_value
            text: ""
            bold: True
            font_size: app_theme.font("title")
            color: app_theme.color("success")
            halign: "left"
            text_size: self.size
            valign: "middle"

    # Observação em bloco full-width, altura por conteúdo
    BoxLayout:
        orientation: "vertical"
        size_hint_y: None
        height: self.minimum_height
        spacing: app_theme.space("xs")

        Label:
            text: "Observação:"
            bold: True
            color: app_theme.color("text_secondary")
            size_hint_y: None
            height: app_theme.widget("field_label_height")
            text_size: self.size
            halign: "left"
            valign: "middle"

        Label:
            id: observacao_value
            text: ""
            color: app_theme.color("text_primary")
            size_hint_y: None
            height: self.texture_size[1]
            text_size: self.width, None
            halign: "left"
            valign: "top"