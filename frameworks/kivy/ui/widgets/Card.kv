<CardWidget>:
    orientation: "vertical"
    size_hint_y: None
    height: self.minimum_height
    spacing: app_theme.space("row")

    GridLayout:
        cols: 2
        size_hint_y: None
        height: self.minimum_height
        # 48dp por linha (input_height): as mini-tabelas CHO/Gordura da última
        # linha têm rótulo em cima do valor e precisam do dobro do row_height antigo.
        row_default_height: app_theme.widget("input_height")
        row_force_default: True
        spacing: [app_theme.space("xl"), app_theme.space("row")]

        BoxLayout:
            spacing: app_theme.space("sm")
            Label:
                text: "Data:"
                bold: True
                color: app_theme.color("text_secondary")
                size_hint_x: None
                width: app_theme.widget("field_label_width")
                halign: "right"
                text_size: self.size
                valign: "middle"
            Label:
                id: data_value
                text: ""
                color: app_theme.color("text_primary")
                halign: "left"
                text_size: self.size
                valign: "middle"

        BoxLayout:
            spacing: app_theme.space("sm")
            Label:
                text: "Horário:"
                bold: True
                color: app_theme.color("text_secondary")
                size_hint_x: None
                width: app_theme.widget("field_label_width")
                halign: "right"
                text_size: self.size
                valign: "middle"
            Label:
                id: horario_value
                text: ""
                color: app_theme.color("text_primary")
                halign: "left"
                text_size: self.size
                valign: "middle"

        BoxLayout:
            spacing: app_theme.space("sm")
            Label:
                text: "Lenta:"
                bold: True
                color: app_theme.color("text_secondary")
                size_hint_x: None
                width: app_theme.widget("field_label_width")
                halign: "right"
                text_size: self.size
                valign: "middle"
            Label:
                id: lenta_value
                text: ""
                color: app_theme.color("text_primary")
                halign: "left"
                text_size: self.size
                valign: "middle"

        BoxLayout:
            spacing: app_theme.space("sm")
            Label:
                text: "Rápida:"
                bold: True
                color: app_theme.color("text_secondary")
                size_hint_x: None
                width: app_theme.widget("field_label_width")
                halign: "right"
                text_size: self.size
                valign: "middle"
            Label:
                id: rapida_value
                text: ""
                color: app_theme.color("text_primary")
                halign: "left"
                text_size: self.size
                valign: "middle"

        BoxLayout:
            spacing: app_theme.space("sm")
            Label:
                text: "Exercício:"
                bold: True
                color: app_theme.color("text_secondary")
                size_hint_x: None
                width: app_theme.widget("field_label_width")
                halign: "right"
                text_size: self.size
                valign: "middle"
            Label:
                id: exercicio_value
                text: ""
                color: app_theme.color("text_primary")
                halign: "left"
                text_size: self.size
                valign: "middle"

        BoxLayout:
            spacing: app_theme.space("sm")
            Label:
                text: "Refeição:"
                bold: True
                color: app_theme.color("text_secondary")
                size_hint_x: None
                width: app_theme.widget("field_label_width")
                halign: "right"
                text_size: self.size
                valign: "middle"
            Label:
                id: refeicao_value
                text: ""
                color: app_theme.color("text_primary")
                halign: "left"
                text_size: self.size
                valign: "middle"

        # Última linha: Dextro na primeira coluna (era um bloco isolado embaixo do
        # grid, desperdiçando metade da largura) e, na segunda coluna, CHO e
        # Gordura dividem a metade direita — 1/4 do grid cada, rótulo sobre valor.
        BoxLayout:
            spacing: app_theme.space("sm")
            Label:
                text: "Dextro:"
                bold: True
                color: app_theme.color("text_secondary")
                size_hint_x: None
                width: app_theme.widget("field_label_width")
                halign: "right"
                text_size: self.size
                valign: "middle"
            Label:
                id: dextro_value
                text: ""
                bold: True
                font_size: app_theme.font("title")
                color: app_theme.color("success")
                halign: "left"
                text_size: self.size
                valign: "middle"

        # Quantidades: rótulo SEM dois pontos — o valor fica EMBAIXO, e dois
        # pontos sugerem valor ao lado do rótulo (reportado em uso real). O bloco
        # tem altura por conteúdo e fica CENTRALIZADO na célula de 48dp via
        # pos_hint (BoxLayout horizontal honra center_y no eixo cruzado), com gap
        # curto entre rótulo e valor — antes o valor flutuava longe do rótulo.
        BoxLayout:
            spacing: app_theme.space("md")

            BoxLayout:
                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height
                pos_hint: {"center_y": 0.5}
                spacing: app_theme.space("xs")

                Label:
                    text: "CHO"
                    bold: True
                    font_size: app_theme.font("caption")
                    color: app_theme.color("text_secondary")
                    size_hint_y: None
                    height: self.texture_size[1]
                Label:
                    id: carboidratos_value
                    text: ""
                    font_size: app_theme.font("field")
                    color: app_theme.color("text_primary")
                    size_hint_y: None
                    height: self.texture_size[1]

            BoxLayout:
                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height
                pos_hint: {"center_y": 0.5}
                spacing: app_theme.space("xs")

                Label:
                    text: "Gordura"
                    bold: True
                    font_size: app_theme.font("caption")
                    color: app_theme.color("text_secondary")
                    size_hint_y: None
                    height: self.texture_size[1]
                Label:
                    id: gorduras_value
                    text: ""
                    font_size: app_theme.font("field")
                    color: app_theme.color("text_primary")
                    size_hint_y: None
                    height: self.texture_size[1]

    # Observação em bloco full-width, altura por conteúdo. Rótulo sem dois
    # pontos, pela mesma razão de CHO/Gordura: o texto fica EMBAIXO dele.
    BoxLayout:
        orientation: "vertical"
        size_hint_y: None
        height: self.minimum_height
        spacing: app_theme.space("xs")

        Label:
            text: "Observação"
            bold: True
            color: app_theme.color("text_secondary")
            size_hint_y: None
            height: app_theme.widget("field_label_height")
            text_size: self.size
            halign: "left"
            valign: "middle"

        Label:
            id: observacao_value
            text: ""
            color: app_theme.color("text_primary")
            size_hint_y: None
            height: self.texture_size[1]
            text_size: self.width, None
            halign: "left"
            valign: "top"