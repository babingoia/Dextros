#:import app_theme frameworks.kivy.ui.app_theme

<GenericMatrixGraph>:
    viewclass: 'MatrixCell'

    # Scroll normal nas duas direções; trava só durante o pinch
    # (a view binda zoom.is_pinching -> graph.scroll_locked).
    do_scroll_x: not root.scroll_locked
    do_scroll_y: not root.scroll_locked

    # Scrollbar no tema.
    bar_width: app_theme.widget('scrollbar')
    bar_color: app_theme.color('scrollbar')
    bar_inactive_color: app_theme.color('border')

    RecycleGridLayout:
        # cols do render atual (muda com headers_visible, quem seta é o renderer).
        cols: root.layout_cols

        # Métricas vêm do renderer (scale * métricas da MatrixCell).
        default_size: root.cell_width, root.cell_height
        spacing: root.cell_spacing
        default_size_hint: None, None

        # Força o grid a crescer o suficiente para habilitar o scroll 2D.
        size_hint: None, None
        width: self.minimum_width
        height: self.minimum_height